[Desktop Entry]
Type=Application
Name=Swifty
GenericName=Music Player
Comment=Play your music files
Exec=swifty %u
Icon=swifty
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;player;lyrics;local;
MimeType=x-scheme-handler/swifty;
StartupWMClass=swifty
SingleMainWindow=true
Actions=Immersive;PlayPause;

[Desktop Action Immersive]
Name=Open Immersive Player
Exec=swifty --immersive

[Desktop Action PlayPause]
Name=Play or Pause
Exec=swifty --play-pause
